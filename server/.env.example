# Skillforge 服务端配置示例
# 复制为 .env 并按需修改

# --- 网络 ---
SKILLFORGE_HOST=127.0.0.1
SKILLFORGE_PORT=8765

# --- 数据 ---
SKILLFORGE_DB_PATH=./data/skillforge.db

# --- 向量编码 ---
# 384 维、CPU 友好。首次启动会自动从 HuggingFace 下载
SKILLFORGE_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- 重排器 ---
# ollama / haiku / none
SKILLFORGE_RERANKER=ollama
SKILLFORGE_RERANKER_MODEL=qwen2.5:1.5b
SKILLFORGE_OLLAMA_HOST=http://localhost:11434

# 仅当 SKILLFORGE_RERANKER=haiku 时需要
# SKILLFORGE_ANTHROPIC_API_KEY=sk-ant-...

# --- 推荐参数 ---
SKILLFORGE_TOP_K_DEFAULT=3
SKILLFORGE_RETRIEVE_K=30
SKILLFORGE_MAX_TOKENS_DEFAULT=4000

# --- 鉴权（可选）---
# 设置后所有写操作要求 Authorization: Bearer <key>
# SKILLFORGE_API_KEY=changeme

# --- GitHub ingest ---
# 提高 rate limit / 访问私有仓库
# SKILLFORGE_GITHUB_TOKEN=ghp_...

# --- 远程发现（默认关闭）---
# 启用后会定期扫描 GitHub 找高质量 skill，进审批队列
SKILLFORGE_ENABLE_REMOTE_FINDER=false
SKILLFORGE_FINDER_INTERVAL_SECONDS=86400

# --- 日志 ---
SKILLFORGE_LOG_LEVEL=INFO
SKILLFORGE_LOG_FORMAT=json
